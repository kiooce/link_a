FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 1;
lx0 -4900;
ly0 -2800;
lz0 0;

lx1 5000;
ly1 3600;
lz1 2000;

factor 0.015625;

xCells #calc "round(9900*$factor)";
yCells #calc "round(6400*$factor)";
zCells #calc "round(2000*$factor)";

vertices
(
    ($lx0 $ly0 $lz0)
    ($lx1 $ly0 $lz0)
    ($lx1 $ly1 $lz0)
    ($lx0 $ly1 $lz0)
    ($lx0 $ly0 $lz1)
    ($lx1 $ly0 $lz1)
    ($lx1 $ly1 $lz1)
    ($lx0 $ly1 $lz1)
);

edges
(
);

blocks
(
    hex (0 1 2 3 4 5 6 7) ($xCells $yCells $zCells) simpleGrading (1 1 1)
);

boundary
(
    atmosphere
    {
        type patch;
        faces
        (
            (4 5 6 7)
        );
    }
    bottom
    {
        type wall;
        faces
        (
            (0 3 2 1)
        );
    }
    side4
    {
        type patch;
        faces
        (
            (1 5 4 0)
        );
    }
    side3
    {
        type patch;
        faces
        (
            (3 7 6 2)
        );
    }

    side2
    {
        type patch;
        faces
        (
            (0 4 7 3)
        );
    }
    side1
    {
        type patch;
        faces
        (
            (2 6 5 1)
        );
    }
);

mergePatchPairs
(
);
